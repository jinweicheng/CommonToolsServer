# Local development env example for CommonToolsServer
# Copy to .env.local or set these in your shell before running.

# Database - for quick local use you can run MySQL or point to an H2 file DB
# Example MySQL (local dev):
DB_URL=jdbc:mysql://127.0.0.1:3306/commontools?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Redis: disabled for local dev by default
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# OAuth2: disabled locally unless you provide client IDs/secrets
OAUTH2_ENABLED=false
# If enabling, set provider client ids/secrets, e.g.:
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# App / security
FRONTEND_URL=http://localhost:3000
# Keep a strong secret in production. For local dev you may reuse this value.
JWT_SECRET=CommonToolsSecretKeyForJWTTokenGeneration2024

# Optional: adjust refresh expiration days (in days)
AUTH_REFRESH_EXPIRATION_DAYS=30

# Notes:
# - application.yml already defaults OAUTH2_ENABLED and REDIS_ENABLED to false via ${...:false}.
# - In production, use actual secrets and enable Redis/OAuth via environment variables or your deployment system.
# - To run locally with these vars on Windows PowerShell:
#   $env:DB_URL="<value>"; $env:DB_USERNAME="<value>"; $env:DB_PASSWORD="<value>"; $env:REDIS_ENABLED="false"; mvn -DskipTests compile
